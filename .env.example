# Base Postgres (Neon, Supabase, Vercel Postgres…). Sans cette variable, l'appli tourne en mémoire (démo).
DATABASE_URL=
# 32 caractères aléatoires minimum : openssl rand -base64 32
SESSION_SECRET=
# Clé AES-256 en base64 (32 octets) : openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Adresse publique du site, sans slash final
APP_URL=http://localhost:3000
# Secret de la tâche quotidienne (Vercel l'envoie en Bearer) : openssl rand -hex 24
CRON_SECRET=
# Coach IA (facultatif) : Gemini ou Anthropic. Si les deux clés existent, COACH_PROVIDER tranche (gemini | anthropic).
COACH_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Strava (facultatif) : https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_VERIFY_TOKEN=
# Inscription ouverte ? mettre "closed" pour la fermer une fois ton compte créé
SIGNUP=open
